ARCH=arm64
CLANG_TRIPLE=aarch64-linux-gnu-
CROSS_COMPILE=aarch64-linux-androidkernel-
CC=clang
LD=ld.lld
LD_LIBRARY_PATH=~/android/lineage/prebuilts/clang/host/linux-x86/clang-r383902/lib64:$$LD_LIBRARY_PATH
NM=llvm-nm
OBJCOPY=llvm-objcopy
DEFCONFIG=camellian_gl_defconfig
#KERNEL_DIR=kernel-4.14
CLANG_PREBUILT_BIN=~/android/lineage/prebuilts/clang/host/linux-x86/clang-r383902/bin
LINUX_GCC_CROSS_COMPILE_PREBUILTS_BIN=~/android/lineage/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9/bin
KERNEL_TOOLCHAIN_ARM64 := ~android/lineage/prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9/bin
KERNEL_TOOLCHAIN_ARM32 := ~android/lineage/prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9/bin